rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true &&
        request.auth.token.email is string;
    }
    function own(uid) {
      return verified() && request.auth.uid == uid;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function id(value) {
      return value is string && value.matches('^[a-z0-9_-]{20,50}$');
    }
    function text(value, size) {
      return value is string && value.size() > 0 && value.size() <= size;
    }
    function workspace(space) {
      return /databases/$(database)/documents/households/$(space);
    }
    function membership(space, uid) {
      return /databases/$(database)/documents/households/$(space)/members/$(uid);
    }
    function access(space, uid, account) {
      return /databases/$(database)/documents/households/$(space)/members/$(uid)/access/$(account);
    }
    function invite(space, code) {
      return /databases/$(database)/documents/households/$(space)/invites/$(code);
    }
    function owner(space) {
      return verified() && get(workspace(space)).data.owner == request.auth.uid;
    }
    function active(space, uid) {
      return exists(membership(space, uid)) && get(membership(space, uid)).data.active == true;
    }
    function member(space) {
      return verified() && active(space, request.auth.uid);
    }
    function hasAccess(space, account, roles) {
      return member(space) && exists(access(space, request.auth.uid, account)) &&
        get(access(space, request.auth.uid, account)).data.generation ==
          get(membership(space, request.auth.uid)).data.generation &&
        get(access(space, request.auth.uid, account)).data.role in roles;
    }
    function canRead(space, account) {
      return owner(space) || hasAccess(space, account, ['viewer', 'editor']);
    }
    function canEdit(space, account) {
      return owner(space) || hasAccess(space, account, ['editor']);
    }
    function validMembership(space, uid) {
      let data = request.resource.data;
      let token = invite(space, data.generation);
      return own(uid) &&
        data.keys().hasOnly(['email', 'generation', 'active', 'joinedAt']) &&
        data.email == email() && id(data.generation) && data.active == true &&
        data.joinedAt == request.time &&
        get(token).data.state == 'open' && get(token).data.email == email() &&
        get(token).data.expiresAt > request.time &&
        getAfter(token).data.state == 'accepted' && getAfter(token).data.acceptedBy == uid;
    }
    function validEntry(space, data) {
      return data.keys().hasOnly([
        'title', 'minor', 'day', 'deleted', 'revision',
        'author', 'updatedBy', 'generation', 'mutation', 'createdAt', 'updatedAt'
      ]) &&
        text(data.title, 100) && data.minor is int && data.minor != 0 &&
        data.minor >= -999999999999 && data.minor <= 999999999999 &&
        data.day is string &&
        data.day.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') &&
        data.deleted is bool && data.revision is int &&
        data.updatedBy == request.auth.uid && id(data.mutation) &&
        ((owner(space) && data.generation == 'owner') ||
          (member(space) && data.generation ==
            get(membership(space, request.auth.uid)).data.generation)) &&
        data.updatedAt == request.time;
    }

    match /householdUsers/{uid}/links/{space} {
      allow get, list: if own(uid);
      allow create, update: if own(uid) && id(space) &&
        request.resource.data.keys().hasOnly(['linkedAt']) &&
        request.resource.data.linkedAt == request.time &&
        (getAfter(workspace(space)).data.owner == uid ||
          getAfter(membership(space, uid)).data.active == true);
      allow delete: if own(uid) && !active(space, uid) && !owner(space);
    }

    match /households/{space} {
      allow get: if owner(space) || member(space);
      allow create: if verified() && id(space) &&
        request.resource.data.keys().hasOnly(['owner', 'name', 'createdAt']) &&
        request.resource.data.owner == request.auth.uid &&
        text(request.resource.data.name, 70) &&
        request.resource.data.createdAt == request.time;

      match /invites/{code} {
        allow get: if owner(space) || (verified() &&
          resource.data.email == email() && resource.data.state == 'open' &&
          resource.data.expiresAt > request.time);
        allow list: if owner(space);
        allow create: if owner(space) && id(code) &&
          request.resource.data.keys().hasOnly(['email', 'expiresAt', 'createdAt', 'state']) &&
          text(request.resource.data.email, 254) &&
          request.resource.data.email == request.resource.data.email.lower() &&
          request.resource.data.expiresAt is timestamp &&
          request.resource.data.expiresAt > request.time &&
          request.resource.data.expiresAt <= request.time + duration.value(7, 'd') &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.state == 'open';
        allow update: if resource.data.state == 'open' && (
          (owner(space) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']) &&
            request.resource.data.state == 'revoked') ||
          (verified() && email() == resource.data.email &&
            resource.data.expiresAt > request.time &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['state', 'acceptedBy']) &&
            request.resource.data.state == 'accepted' &&
            request.resource.data.acceptedBy == request.auth.uid &&
            getAfter(membership(space, request.auth.uid)).data.generation == code &&
            getAfter(membership(space, request.auth.uid)).data.active == true)
        );
      }

      match /members/{uid} {
        allow get: if owner(space) || own(uid);
        allow list: if owner(space);
        allow create: if validMembership(space, uid);
        allow update: if (owner(space) && resource.data.active == true &&
          request.resource.data.active == false &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])) ||
          (resource.data.active == false && validMembership(space, uid));

        match /access/{account} {
          allow get, list: if owner(space) || (own(uid) && active(space, uid));
          allow create, update: if owner(space) && active(space, uid) &&
            exists(/databases/$(database)/documents/households/$(space)/accounts/$(account)) &&
            request.resource.data.keys().hasOnly(['role', 'generation']) &&
            request.resource.data.role in ['viewer', 'editor'] &&
            request.resource.data.generation == get(membership(space, uid)).data.generation;
          allow delete: if owner(space);
        }
      }

      match /accounts/{account} {
        allow get: if canRead(space, account);
        allow list: if owner(space);
        allow create: if owner(space) && id(account) &&
          request.resource.data.keys().hasOnly(['name', 'currency', 'decimals', 'opening', 'createdAt']) &&
          text(request.resource.data.name, 70) &&
          request.resource.data.currency is string &&
          request.resource.data.currency.matches('^[A-Z]{3}$') &&
          request.resource.data.decimals is int &&
          request.resource.data.decimals >= 0 && request.resource.data.decimals <= 3 &&
          request.resource.data.opening is int &&
          request.resource.data.opening >= -999999999999 &&
          request.resource.data.opening <= 999999999999 &&
          request.resource.data.createdAt == request.time;

        match /entries/{entry} {
          allow get, list: if canRead(space, account);
          allow create: if canEdit(space, account) && id(entry) &&
            exists(/databases/$(database)/documents/households/$(space)/accounts/$(account)) &&
            validEntry(space, request.resource.data) &&
            request.resource.data.deleted == false &&
            request.resource.data.revision == 1 &&
            request.resource.data.mutation == entry &&
            request.resource.data.author == request.auth.uid &&
            request.resource.data.createdAt == request.time;
          allow update: if canEdit(space, account) && resource.data.deleted == false &&
            validEntry(space, request.resource.data) &&
            request.resource.data.revision == resource.data.revision + 1 &&
            request.resource.data.mutation != resource.data.mutation &&
            request.resource.data.author == resource.data.author &&
            request.resource.data.createdAt == resource.data.createdAt;
        }
      }
    }
  }
}
